<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PACKAGE@"
    android:versionCode="@VERSION_CODE@"
    android:versionName="@VERSION_NAME@">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <!-- the only permissions: vibration (no prompt) and reminders (asked only if the player wants them) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@LABEL@"
        android:icon="@drawable/icon"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name="com.forxastudio.znakex.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name="com.forxastudio.znakex.Reminder" android:exported="false" />
    </application>
</manifest>
